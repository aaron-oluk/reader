<?xml version="1.0" encoding="utf-8"?>
<!-- Document page preview for Edit & Sign — Signet recessed canvas card -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp"
    android:paddingBottom="16dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="6dp"
        app:cardElevation="3dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/background_white">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="200dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/page_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:contentDescription="PDF page"
                android:importantForAccessibility="no" />

            <ProgressBar
                android:id="@+id/page_progress"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/primary_blue"
                android:visibility="visible" />

            <!-- Inline text / date annotation overlay — receives taps in text/date mode -->
            <FrameLayout
                android:id="@+id/text_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false" />

            <!-- Signature overlays — one child view per placed signature -->
            <FrameLayout
                android:id="@+id/signature_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false" />

            <!-- Kept for binary compatibility; unused -->
            <com.pdfreader.app.DraggableSignatureView
                android:id="@+id/signature_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/page_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_page_badge"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:fontFamily="@font/montserrat_semibold"
                android:letterSpacing="0.06"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:text="PAGE 1"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no" />

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
